# Server
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MySQL Database
DB_URL=jdbc:mysql://localhost:3306/drive_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
JPA_SHOW_SQL=false

# File Upload Storage
FILE_UPLOAD_DIR=uploads
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=25MB
